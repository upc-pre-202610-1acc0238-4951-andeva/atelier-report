manager = person "Dueño de Taller" "Dueño o administrador de una sucursal B2B. Gestiona finanzas, inventario y personal."
mechanic = person "Mecánico" "Empleado técnico del taller B2B. Registra su progreso y realiza mantenimientos/reparaciones."
driver = person "Conductor / Dueño de Flota" "Cliente B2C. Consume mantenimientos preventivos, revisa histórico de su vehículo y agenda citas."
